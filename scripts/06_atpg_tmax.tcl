#####################################################################
# 06_atpg_tmax.tcl  -  TetraMAX / TestMAX ATPG on the post-route netlist
#
# Use this one if 00_check_env.csh found  tmax  (Synopsys).
# If it found  modus  (Cadence) instead, use 06_atpg_modus.tcl.
#
# Usage (from ~/sm_dft, in the tab whose setup file puts tmax on the PATH):
#   mkdir -p atpg
#   tmax -shell scripts/06_atpg_tmax.tcl |& tee atpg/tmax_run.log
#   (if your version complains about the arguments, try:  tmax -nogui -tcl scripts/06_atpg_tmax.tcl)
#
# Stuck-at first. Transition-delay (launch-on-capture) is part 2 below;
# set  setenv ATPG_TRANSITION 1  to run it as well.
#####################################################################

set PDK /tools/PDK/NCSU45PDK/FreePDK45/osu_soc/lib/files
set NET [expr {[info exists ::env(NETLIST)] ? $::env(NETLIST) : "pnr/sm_top/sm_top_pnr.v"}]
file mkdir atpg
set_messages -log atpg/tmax.log -replace

#--------------------------------------------------------------------
# 1. Netlist + cell models, build the ATPG model
#--------------------------------------------------------------------
read_netlist $PDK/gscl45nm.v -library
read_netlist $NET
run_build_model sm_top

#--------------------------------------------------------------------
# 2. Test protocol without an SPF ("quick STIL"): clocks, scan chains,
#    scan enable, async resets held off during shift (generated by
#    scan_insert.py from the real chain map)
#--------------------------------------------------------------------
source scan/tmax_scan.tcl
run_drc
report_scan_chains            > atpg/scan_chains.rpt
report_rules -fail            > atpg/drc_violations.rpt

#--------------------------------------------------------------------
# 3. Stuck-at ATPG
#--------------------------------------------------------------------
set_faults -model stuck
add_faults -all
run_atpg -auto_compression
report_summaries              > atpg/stuck_summary.rpt
report_summaries
report_faults -class AU       > atpg/stuck_AU_faults.rpt
report_faults -class UD       > atpg/stuck_UD_faults.rpt
write_faults atpg/stuck_faults.txt -all -replace
write_patterns atpg/sm_top_stuck.stil -format stil -replace

#--------------------------------------------------------------------
# 4. (optional) Transition-delay faults, launch-on-capture
#    The flow here pulses the functional clock twice in capture; with no
#    on-chip clock controller this is the tester's clock, so treat the
#    result as "slow-speed transition" coverage, not at-speed test.
#--------------------------------------------------------------------
if {[info exists ::env(ATPG_TRANSITION)] && $::env(ATPG_TRANSITION)} {
  remove_faults -all
  set_faults -model transition
  set_delay -launch_cycle system_clock
  add_faults -all
  run_atpg -auto_compression
  report_summaries            > atpg/transition_summary.rpt
  report_summaries
  write_patterns atpg/sm_top_transition.stil -format stil -replace
}

exit
